# Go-Eat suggestion API — backend environment.
#
# CONSTITUTION V (Location Is Borrowed, Not Kept): provider credentials MUST NOT be embedded in
# the client. This file is the ONLY place GOOGLE_PLACES_API_KEY is ever read from. It must never
# be copied into apps/mobile/, into app.config.ts, or into any EXPO_PUBLIC_* variable — anything
# prefixed EXPO_PUBLIC_ is compiled into the shipped bundle and is readable by anyone with the
# app. `npm run check:secrets` asserts this and fails the build if the key appears under
# apps/mobile/ (T108).
GOOGLE_PLACES_API_KEY=

# Port the stateless backend listens on. The client points at this via EXPO_PUBLIC_API_URL.
PORT=3000
