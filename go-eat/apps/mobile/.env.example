# Go-Eat mobile app — client environment.
#
# EXPO_PUBLIC_* variables are inlined into the shipped JS bundle and are NOT secret. Only
# non-sensitive values belong here. The Google Places key lives exclusively in
# services/suggestion-api/.env (Constitution V).

# iOS Simulator reaches the host machine on localhost:
EXPO_PUBLIC_API_URL=http://localhost:3000

# Android emulator does NOT — 127.0.0.1 inside the emulator is the emulator itself. The host is
# reachable at the special alias 10.0.2.2. Swap the line above for this one when running Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
